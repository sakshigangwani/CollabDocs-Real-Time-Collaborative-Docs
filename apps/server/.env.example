# Copy this file to apps/server/.env and fill in real values.
# (.env is gitignored — never commit real secrets.)

# PostgreSQL connection string.
# Local (Postgres.app): postgresql://<your-mac-username>@localhost:5432/collabdocs?schema=public
# Hosted (Railway/Neon): paste the connection string they give you.
DATABASE_URL="postgresql://USER@localhost:5432/collabdocs?schema=public"

PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Redis (optional in dev, REQUIRED to run more than one server) ---
# Redis does two jobs here:
#   1. The OT step log — every document's steps are appended with an atomic
#      compare-and-append, so all instances agree on one order of edits, and steps and
#      presence are fanned out over pub/sub so users on different instances edit
#      together and see each other's cursors.
#   2. Rate limiting — shares the counters across instances.
# Without REDIS_URL both fall back to in-process: fine for a single instance / dev,
# but a second instance would NOT share collaboration state.
# GET /health reports "collabSync": "redis" | "single-instance".
# REDIS_URL=redis://localhost:6379

# Optional friendly name for this instance in logs and /health (defaults to a uuid).
# INSTANCE_ID=

# --- AI assistant (optional, OpenAI) ---
# Powers document Q&A with citations and the inline writing actions.
# Leave OPENAI_API_KEY unset: the AI routes return 503 and the UI hides itself.
# Get a key at https://platform.openai.com/api-keys
# Embeddings are cheap (text-embedding-3-small); a background job re-embeds at most
# 20 changed documents every 10 minutes, and a document is re-embedded on demand
# when you ask a question in it.
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Object storage (optional, S3) ---
# Stores uploaded images/files (and is read once to migrate pre-OT Yjs snapshots).
# Leave unset in dev: files are written to apps/server/.storage/ instead (same code path,
# GET /api/v1/storage reports {"driver":"local"}).
# To use real S3: create a bucket, then an IAM user with s3:GetObject/PutObject/DeleteObject
# on arn:aws:s3:::<bucket>/*. Keep the bucket PRIVATE — files are served through
# short-lived presigned URLs, never public reads.
# S3_BUCKET=collabdocs-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# S3-compatible providers (Cloudflare R2, MinIO, Backblaze B2) work too — just set an endpoint:
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
#
# Secret used to sign the ?t= token on attachment URLs (falls back to COLLAB_JWT_SECRET).
# ATTACHMENT_SECRET=

# --- Email (optional) ---
# Notification emails (instant + digests) are sent via Resend.
# Leave RESEND_API_KEY unset in dev: emails are logged ("[email skipped] …") instead of sent.
# To send for real: create a key at https://resend.com/api-keys and verify a sending domain,
# then set EMAIL_FROM to an address on that domain.
# RESEND_API_KEY=
# EMAIL_FROM="CollabDocs <notifications@yourdomain.com>"

# --- Billing (optional, Stripe test mode) ---
# Leave unset: billing shows "not configured" and upgrade is disabled.
# To enable: create test-mode keys at https://dashboard.stripe.com/test/apikeys,
# a recurring Price for the Pro plan, and a webhook signing secret
# (use `stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe` locally).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- OAuth (optional) ---
# Email + password works without these. Fill them in to enable the
# "Continue with Google / GitHub" buttons.

# Google: https://console.cloud.google.com/apis/credentials
#   Create "OAuth client ID" → Web application.
#   Authorized redirect URI: http://localhost:4000/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# GitHub: https://github.com/settings/developers → New OAuth App
#   Authorization callback URL: http://localhost:4000/api/v1/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:4000/api/v1/auth/github/callback
